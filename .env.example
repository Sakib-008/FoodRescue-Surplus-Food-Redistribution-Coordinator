# Copy to .env and change the values. .env is git-ignored - never commit it.
POSTGRES_DB=foodrescue
POSTGRES_USER=foodrescue
POSTGRES_PASSWORD=change-this-db-password

# at least 32 characters, e.g. the output of: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# first admin account, created on start-up (leave ADMIN_PASSWORD empty to skip)
ADMIN_EMAIL=admin@foodrescue.local
ADMIN_PASSWORD=ChangeMe-Admin-123

# only for: docker compose --profile monitoring up
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
